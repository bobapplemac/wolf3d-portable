set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR i586)
set(CMAKE_SYSROOT /opt/rh9)
set(CMAKE_C_COMPILER gcc)
set(CMAKE_C_FLAGS_INIT "-m32 -march=pentium -mno-mmx -mno-sse -mno-sse2 -mfpmath=387 -fno-stack-protector -fgnu89-inline -B/opt/rh9/usr/lib/")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-m32 -no-pie -Wl,--hash-style=sysv -static-libgcc")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-m32 -Wl,--hash-style=sysv -static-libgcc")
set(CMAKE_FIND_ROOT_PATH /opt/rh9)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_CROSSCOMPILING_EMULATOR "/opt/rh9/lib/ld-linux.so.2;--library-path;/opt/rh9/lib:/opt/rh9/usr/lib:/opt/rh9/usr/X11R6/lib" CACHE STRING "Run tests with the old userspace (host kernel remains modern)")
