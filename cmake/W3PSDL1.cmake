# Pinned official SDL 1.2 SDK. No import library is linked: only headers and the
# replaceable runtime DLL are needed, independent of the host compiler.
set(SDL1_ROOT "" CACHE PATH "Optional SDL1 SDK prefix (include/SDL, bin/SDL.dll, COPYING)")
if(NOT SDL1_ROOT)
    set(sdk_cache "${CMAKE_BINARY_DIR}/dependencies")
    set(archive "${sdk_cache}/SDL-devel-1.2.15-VC.zip")
    file(MAKE_DIRECTORY "${sdk_cache}")
    set(expected 7443ee5cd1bd2a0f9fa8c01acbeb4c779d0b03f9ce8a2aa47b0637d2a5461e50)
    if(EXISTS "${archive}")
        file(SHA256 "${archive}" actual)
    endif()
    if(NOT actual STREQUAL expected)
        file(DOWNLOAD "https://www.libsdl.org/release/SDL-devel-1.2.15-VC.zip"
            "${archive}" EXPECTED_HASH SHA256=${expected} TLS_VERIFY ON STATUS download)
        list(GET download 0 status)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "Cannot download SDL1 SDK; set SDL1_ROOT to an offline SDK: ${download}")
        endif()
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
        WORKING_DIRECTORY "${sdk_cache}" RESULT_VARIABLE extracted)
    if(NOT extracted EQUAL 0)
        message(FATAL_ERROR "Cannot extract the verified SDL1 SDK")
    endif()
    set(SDL1_ROOT "${sdk_cache}/sdl1")
    file(MAKE_DIRECTORY "${SDL1_ROOT}/include/SDL" "${SDL1_ROOT}/bin")
    file(COPY "${sdk_cache}/SDL-1.2.15/include/" DESTINATION "${SDL1_ROOT}/include/SDL")
    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(sdl_arch x64)
    else()
        set(sdl_arch x86)
    endif()
    configure_file("${sdk_cache}/SDL-1.2.15/lib/${sdl_arch}/SDL.dll" "${SDL1_ROOT}/bin/SDL.dll" COPYONLY)
    configure_file("${sdk_cache}/SDL-1.2.15/COPYING.txt" "${SDL1_ROOT}/COPYING" COPYONLY)
endif()
set(SDL1_INCLUDE "${SDL1_ROOT}/include")
set(SDL1_DLL "${SDL1_ROOT}/bin/SDL.dll")
set(SDL1_LICENSE "${SDL1_ROOT}/COPYING")
foreach(required "${SDL1_INCLUDE}/SDL/SDL.h" "${SDL1_DLL}" "${SDL1_LICENSE}")
    if(NOT EXISTS "${required}")
        message(FATAL_ERROR "Incomplete SDL1_ROOT: missing ${required}")
    endif()
endforeach()
