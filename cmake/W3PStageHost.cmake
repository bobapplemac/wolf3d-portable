cmake_policy(PUSH)
cmake_policy(SET CMP0054 NEW)
file(REMOVE_RECURSE "${DIST}")
file(MAKE_DIRECTORY "${DIST}/DOCS/LICENSES")
foreach(binary IN LISTS RUNTIME)
    file(COPY "${binary}" DESTINATION "${DIST}" FOLLOW_SYMLINK_CHAIN)
endforeach()
# Preserve SONAME links for the versioned engine and SDL libraries.
file(GLOB libraries "${DIST}/*.so.*")
foreach(library IN LISTS libraries)
    get_filename_component(name "${library}" NAME)
    if(name MATCHES "^(.*\\.so\\.[0-9]+)\\.")
        file(CREATE_LINK "${name}" "${DIST}/${CMAKE_MATCH_1}" SYMBOLIC)
    endif()
endforeach()
foreach(license IN LISTS LICENSES)
    string(REPLACE "|" ";" pair "${license}")
    list(GET pair 0 source)
    list(GET pair 1 name)
    configure_file("${source}" "${DIST}/DOCS/LICENSES/${name}" COPYONLY)
endforeach()
configure_file("${INFO}" "${DIST}/DOCS/BUILD.TXT" COPYONLY)
file(APPEND "${DIST}/DOCS/BUILD.TXT" "Compiled video backends: ${BACKENDS}\nDefault video backend: auto (SDL, then native host)\n")
set(INFO "${DIST}/DOCS/BUILD.TXT")
set(ENGINE "${ROOT}/lib/wolf3d")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DINFO=${INFO}" "-DROOT=${ROOT}"
    "-DENGINE=${ENGINE}" "-DCACHE=${BUILD}/CMakeCache.txt"
    "-DSETTINGS=${BUILD}/distribution-target-settings.txt"
    -P "${ROOT}/cmake/WGStampBuildInfo.cmake" RESULT_VARIABLE stamp_result)
if(NOT stamp_result EQUAL 0)
    message(FATAL_ERROR "Could not record build settings")
endif()
configure_file("${BUILD}/WOLF3D-LIB.txt" "${DIST}/DOCS/ENGINE.TXT" COPYONLY)
if(DBOPL)
    configure_file("${ENGINE}/third_party/DBOPL/README.wolf3d-lib.md" "${DIST}/DOCS/DBOPL.TXT" COPYONLY)
endif()
file(WRITE "${DIST}/README.TXT" "wolf3d-portable\n\nSupply your own game data.\nCompiled video backends: ${BACKENDS}\n--backend auto (default) prefers SDL, then the native host.\n--backend NAME requires that compiled backend; --help lists its options.\nSDL is loaded on demand; the native host works without its SDL library.\n--diag reports video, input, audio and game-data details.\nDOCS/BUILD.TXT records all build settings.\n")
set(PRODUCT wolf3d-portable)
include("${ROOT}/cmake/WGPackageDocs.cmake")
set(ENABLED "${INPOUT}")
include("${ROOT}/cmake/W3PPackageInpOut32.cmake")
cmake_policy(POP)
