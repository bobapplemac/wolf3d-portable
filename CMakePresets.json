{
  "version": 2,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 16 2019",
      "cacheVariables": {
        "W3P_BUILD_WIN32": "ON",
        "W3P_BUILD_SDL3": "ON",
        "W3P_WARNINGS_AS_ERRORS": "ON",
        "WG_STATIC_MSVC_RUNTIME": "ON"
      }
    },
    {
      "name": "windows-dev-x64",
      "displayName": "Windows hosts (x64)",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/windows-dev-x64",
      "architecture": "x64"
    },
    {
      "name": "windows-dev-x86",
      "displayName": "Windows hosts (x86)",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/windows-dev-x86",
      "architecture": "Win32"
    },
    {
      "name": "windows-release-x64",
      "displayName": "Windows Win32 release (x64)",
      "inherits": "windows-dev-x64",
      "binaryDir": "${sourceDir}/build/windows-release-x64",
      "cacheVariables": { "W3P_BUILD_SDL3": "OFF", "BUILD_TESTING": "OFF" }
    },
    {
      "name": "windows-release-x86",
      "displayName": "Windows Win32 release (x86)",
      "inherits": "windows-dev-x86",
      "binaryDir": "${sourceDir}/build/windows-release-x86",
      "cacheVariables": { "W3P_BUILD_SDL3": "OFF", "BUILD_TESTING": "OFF" }
    },
    {
      "name": "windows-sdl3-x64",
      "displayName": "Windows SDL3 release (x64)",
      "inherits": "windows-dev-x64",
      "binaryDir": "${sourceDir}/build/windows-sdl3-x64",
      "cacheVariables": { "W3P_BUILD_WIN32": "OFF", "BUILD_TESTING": "OFF" }
    },
    {
      "name": "windows-sdl3-x86",
      "displayName": "Windows SDL3 release (x86)",
      "inherits": "windows-dev-x86",
      "binaryDir": "${sourceDir}/build/windows-sdl3-x86",
      "cacheVariables": { "W3P_BUILD_WIN32": "OFF", "BUILD_TESTING": "OFF" }
    },
    {
      "name": "linux-sdl3",
      "displayName": "Linux SDL3 release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-sdl3",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "W3P_BUILD_SDL3": "ON",
        "W3P_BUILD_LINUX_CONSOLE": "OFF",
        "W3P_WARNINGS_AS_ERRORS": "ON",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "linux-console",
      "displayName": "Linux direct-console release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-console",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "W3P_BUILD_SDL3": "OFF",
        "W3P_BUILD_LINUX_CONSOLE": "ON",
        "W3P_WARNINGS_AS_ERRORS": "ON",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-dev-x64", "configurePreset": "windows-dev-x64", "configuration": "Release" },
    { "name": "windows-dev-x86", "configurePreset": "windows-dev-x86", "configuration": "Release" },
    { "name": "windows-release-x64", "configurePreset": "windows-release-x64", "configuration": "Release", "targets": ["win32-release"] },
    { "name": "windows-release-x86", "configurePreset": "windows-release-x86", "configuration": "Release", "targets": ["win32-release"] },
    { "name": "windows-sdl3-x64", "configurePreset": "windows-sdl3-x64", "configuration": "Release", "targets": ["sdl3-release"] },
    { "name": "windows-sdl3-x86", "configurePreset": "windows-sdl3-x86", "configuration": "Release", "targets": ["sdl3-release"] },
    { "name": "linux-sdl3", "configurePreset": "linux-sdl3", "targets": ["sdl3-release"] },
    { "name": "linux-console", "configurePreset": "linux-console", "targets": ["console-release"] }
  ]
}
