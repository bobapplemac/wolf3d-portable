file(REMOVE_RECURSE "${DIST}")
file(MAKE_DIRECTORY "${DIST}/DOCS/LICENSES")
file(COPY "${EXE}" "${ENGINE}" "${SDL}" DESTINATION "${DIST}")
if(NUKED)
 file(GLOB nuked "${BUILD}/wolf3d-lib/*Nuked*.dll" "${BUILD}/wolf3d-lib/*nuked*.dll")
 file(COPY ${nuked} DESTINATION "${DIST}")
 configure_file("${ROOT}/lib/wolf3d/third_party/Nuked-OPL3/LICENSE" "${DIST}/DOCS/LICENSES/LGPL-21.TXT" COPYONLY)
endif()
configure_file("${ROOT}/LICENSE" "${DIST}/DOCS/LICENSES/GPL-2.TXT" COPYONLY)
configure_file("${SDL_LICENSE}" "${DIST}/DOCS/LICENSES/SDL1.TXT" COPYONLY)
if(DBOPL)
 configure_file("${ROOT}/lib/wolf3d/third_party/DBOPL/README.wolf3d-lib.md" "${DIST}/DOCS/DBOPL.TXT" COPYONLY)
endif()
file(WRITE "${DIST}/README.TXT" "wolf3d-portable Windows SDL 1.2 (experimental)\n\nKeep SDL.dll and wolf3d.dll beside wolf3d.exe. Supply your own game data.\nDefault: --sdl-video directx, with windib fallback if initialization fails.\nUse --sdl-video windib to select GDI directly.\nDirectx tries hardware stretching with a 320x200 upload, then SDL software\nstretch on failure. The console reports the selected path.\nDefault: --sdl-scale hardware, with software fallback if unsupported.\nUse --sdl-scale software to skip hardware scaling.\nHardware filtering is display-driver dependent; nearest-neighbor is not guaranteed.\n--window-scale 1/2/3/4 selects the initial 4:3 window size.\nF11 toggles borderless fullscreen (preserves desktop display mode).\nEngine and PCM continue while video is busy or the window is dragged.\nUse --opl auto (default), adlib, dbopl or silent. --help lists common options.\nConsole output remains visible after double-click launch; --no-pause disables it.\nHardware scaling has been tested on Windows 2000; driver support varies.\n")
file(WRITE "${DIST}/DOCS/BUILD.TXT" "Product: wolf3d-portable\nVersion: ${VERSION}\nPlatform baseline: win2k\nArchitecture: x86\nBackend: sdl1\nCompiler: MinGW GCC ${COMPILER}\nSDL: 1.2.15 (windib and directx)\nNative OPL compiled: ${ADLIB}\nSample rate: runtime auto\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DINFO=${DIST}/DOCS/BUILD.TXT" "-DROOT=${ROOT}" "-DENGINE=${ROOT}/lib/wolf3d" "-DCACHE=${BUILD}/CMakeCache.txt" -P "${ROOT}/cmake/WGStampBuildInfo.cmake" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DDIST=${DIST}" "-DROOT=${ROOT}" -DPRODUCT=wolf3d-portable -P "${ROOT}/cmake/WGPackageDocs.cmake" COMMAND_ERROR_IS_FATAL ANY)
file(APPEND "${DIST}/DOCS/NOTICES.TXT" "\nSDL 1.2.15 - Copyright (C) 1997-2012 Sam Lantinga and contributors.\nLGPL 2.1 or later; full license: LICENSES/SDL1.TXT.\nUnmodified corresponding source: https://www.libsdl.org/release/SDL-1.2.15.tar.gz\nSHA-256: d6d316a793e5e348155f0dd93b979798933fb98aa1edebcc108829d6474aad00\nBuild recipe: wolf3d-portable packaging/windows-sdl1/Dockerfile.\nSDL.dll is dynamically linked and replaceable by a compatible modified build.\n")
set(ENABLED ON)
include("${ROOT}/cmake/W3PPackageInpOut32.cmake")

foreach(snapshot "${ROOT}/packaging/windows-sdl1/Dockerfile" "/opt/sdl1/include/SDL/SDL_config.h")
 file(READ "${snapshot}" content)
 file(APPEND "${DIST}/DOCS/BUILD.TXT" "\n===== ${snapshot} =====\n${content}\n")
endforeach()
