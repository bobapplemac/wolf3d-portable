file(REMOVE_RECURSE "${DIST}")
file(MAKE_DIRECTORY "${DIST}/DOCS/LICENSES")
file(COPY "${EXE}" "${ENGINE}" DESTINATION "${DIST}")
get_filename_component(engine_file "${ENGINE}" NAME)
execute_process(COMMAND "${CMAKE_COMMAND}" -E create_symlink "${engine_file}" "${DIST}/${ENGINE_SONAME}" COMMAND_ERROR_IS_FATAL ANY)
# Preserve SDL's SONAME and a replaceable shared LGPL component.
file(COPY_FILE "${SDL}" "${DIST}/libSDL-1.2.so.0")
if(NUKED)
 file(GLOB nuked "${BUILD}/wolf3d-lib/libNuked-OPL3.so*")
 file(COPY ${nuked} DESTINATION "${DIST}")
 file(COPY_FILE "${ROOT}/lib/wolf3d/third_party/Nuked-OPL3/LICENSE" "${DIST}/DOCS/LICENSES/LGPL-21.TXT")
endif()
file(COPY_FILE "${ROOT}/LICENSE" "${DIST}/DOCS/LICENSES/GPL-2.TXT")
file(COPY_FILE "/opt/rh9/usr/share/SDL12-COPYING.txt" "${DIST}/DOCS/LICENSES/SDL1.TXT")
if(DBOPL)
 file(COPY_FILE "${ROOT}/lib/wolf3d/third_party/DBOPL/README.wolf3d-lib.md" "${DIST}/DOCS/DBOPL.TXT")
endif()
file(COPY_FILE "${ROOT}/packaging/linux-rh9/README.TXT" "${DIST}/README.TXT")
file(WRITE "${DIST}/DOCS/BUILD.TXT" "Product: wolf3d-portable\nVersion: ${VERSION}\nPlatform baseline: linux-glibc\nRuntime baseline: Red Hat Linux 9, glibc 2.3.2, kernel 2.4.20\nArchitecture: x86\nCPU baseline: original Pentium/i586, no CMOV/MMX/SSE requirement\nBackend: sdl1\nCompiler: GCC ${COMPILER}\nSDL: genuine SDL 1.2.15, X11 surfaces or dynamically loaded OpenGL 1.1 / OSS PCM\nSample rate: runtime auto; legacy engine preference\nNative OPL compiled: ${ADLIB} (RH9 playback confirmation pending)\nPhysical RH9 validation: pending\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DINFO=${DIST}/DOCS/BUILD.TXT" "-DROOT=${ROOT}" "-DENGINE=${ROOT}/lib/wolf3d" "-DCACHE=${BUILD}/CMakeCache.txt" -P "${ROOT}/cmake/WGStampBuildInfo.cmake" COMMAND_ERROR_IS_FATAL ANY)
file(READ "${ROOT}/packaging/linux-rh9/SHA256SUMS" hashes)
file(APPEND "${DIST}/DOCS/BUILD.TXT" "\nPinned historical inputs:\n${hashes}")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DDIST=${DIST}" "-DROOT=${ROOT}" -DPRODUCT=wolf3d-portable -P "${ROOT}/cmake/WGPackageDocs.cmake" COMMAND_ERROR_IS_FATAL ANY)
file(APPEND "${DIST}/DOCS/NOTICES.TXT" "\nSDL 1.2.15 - Copyright (C) 1997-2012 Sam Lantinga and contributors.\nLicensed under LGPL 2.1 or later; full license: LICENSES/SDL1.TXT.\nUnmodified corresponding source: https://www.libsdl.org/release/SDL-1.2.15.tar.gz\nBuild recipe/flags: wolf3d-portable packaging/linux-rh9/Dockerfile.\nThe separate libSDL-1.2.so.0 may be replaced with a compatible modified build.\nRH9 system libraries are not redistributed in this package.\n")

foreach(snapshot "${ROOT}/packaging/linux-rh9/Dockerfile" "${ROOT}/cmake/toolchains/linux-rh9-i586.cmake" "/opt/rh9/usr/include/SDL/SDL_config.h")
 file(READ "${snapshot}" content)
 file(APPEND "${DIST}/DOCS/BUILD.TXT" "\n===== ${snapshot} =====\n${content}\n")
endforeach()
