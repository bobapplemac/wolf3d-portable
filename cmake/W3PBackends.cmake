# One executable and one staging operation for the selected host set.
set(W3P_BACKENDS "")
if(W3P_BUILD_WIN32)
    list(APPEND W3P_BACKENDS gdi)
endif()
if(W3P_BUILD_SDL3)
    list(APPEND W3P_BACKENDS sdl3)
endif()
if(W3P_BUILD_SDL1)
    list(APPEND W3P_BACKENDS sdl1)
endif()
if(W3P_BUILD_LINUX_CONSOLE)
    list(APPEND W3P_BACKENDS kms-fbdev)
endif()
if(NOT W3P_BACKENDS)
    message(FATAL_ERROR "Select at least one video backend")
endif()
if(WIN32)
    add_executable(wolf3d-host platforms/win32/WG_LAUNCHER.c)
    target_link_libraries(wolf3d-host PRIVATE user32 winmm)
    target_compile_definitions(wolf3d-host PRIVATE WIN32_LEAN_AND_MEAN UNICODE _UNICODE)
    if(MINGW)
        target_link_options(wolf3d-host PRIVATE -municode)
    endif()
else()
    add_executable(wolf3d-host platforms/linux/WG_LAUNCHER.c platforms/WG_BACKENDS.c)
endif()
target_sources(wolf3d-host PRIVATE platforms/WG_HELP.c platforms/WG_TEXT_OUTPUT.c)
target_compile_definitions(wolf3d-host PRIVATE WG_BACKEND_EMBEDDED=1)
w3p_configure_host(wolf3d-host)
w3p_windows_opl(wolf3d-host)
w3p_linux_opl(wolf3d-host)
w3p_copy_engine_runtime(wolf3d-host)
set_target_properties(wolf3d-host PROPERTIES OUTPUT_NAME wolf3d
    BUILD_RPATH "$ORIGIN" BUILD_RPATH_USE_ORIGIN ON INSTALL_RPATH "$ORIGIN")
if(W3P_BUILD_WIN32)
    target_sources(wolf3d-host PRIVATE platforms/win32/WG_WIN32.c)
    target_compile_definitions(wolf3d-host PRIVATE WG_HAVE_GDI=1)
    target_link_libraries(wolf3d-host PRIVATE gdi32 shell32)
    add_custom_target(wolf3d-win32 DEPENDS wolf3d-host)
endif()
if(W3P_BUILD_SDL3)
    target_sources(wolf3d-host PRIVATE platforms/sdl3/WG_SDL3.c platforms/sdl3/WG_SDL3_DYNAMIC.c)
    target_compile_definitions(wolf3d-host PRIVATE WG_HAVE_SDL3=1 WG_SDL3_DYNAMIC=1)
    target_include_directories(wolf3d-host PRIVATE $<TARGET_PROPERTY:SDL3::SDL3-shared,INTERFACE_INCLUDE_DIRECTORIES>)
    target_link_libraries(wolf3d-host PRIVATE ${CMAKE_DL_LIBS})
    add_dependencies(wolf3d-host SDL3::SDL3-shared)
    add_custom_command(TARGET wolf3d-host POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different "$<TARGET_FILE:SDL3::SDL3-shared>" "$<TARGET_FILE_DIR:wolf3d-host>"
        VERBATIM)
    if(UNIX)
        add_custom_command(TARGET wolf3d-host POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E create_symlink "$<TARGET_FILE_NAME:SDL3::SDL3-shared>"
                "$<TARGET_FILE_DIR:wolf3d-host>/$<TARGET_SONAME_FILE_NAME:SDL3::SDL3-shared>" VERBATIM)
    endif()
    add_custom_target(wolf3d-sdl3 DEPENDS wolf3d-host)
endif()
if(W3P_BUILD_LINUX_CONSOLE)
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(LIBDRM REQUIRED IMPORTED_TARGET libdrm)
    pkg_check_modules(ALSA REQUIRED IMPORTED_TARGET alsa)
    target_sources(wolf3d-host PRIVATE platforms/linux-console/MAIN.c platforms/linux-console/WG_LINUX_CONSOLE.c)
    target_compile_definitions(wolf3d-host PRIVATE WG_HAVE_KMS=1)
    target_link_libraries(wolf3d-host PRIVATE PkgConfig::LIBDRM PkgConfig::ALSA)
    add_custom_target(wolf3d-console DEPENDS wolf3d-host)
endif()
if(W3P_BUILD_SDL1)
    include("${CMAKE_SOURCE_DIR}/cmake/W3PSDL1.cmake")
    target_sources(wolf3d-host PRIVATE platforms/sdl1/WG_SDL1.c platforms/sdl1/WG_SDL1_DYNAMIC.c)
    target_include_directories(wolf3d-host PRIVATE "${SDL1_INCLUDE}")
    target_compile_definitions(wolf3d-host PRIVATE WG_HAVE_SDL1=1 WG_SDL1_DYNAMIC=1)
    add_custom_command(TARGET wolf3d-host POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different "${SDL1_DLL}" "$<TARGET_FILE_DIR:wolf3d-host>" VERBATIM)
endif()

wg_distribution(W3P_RELEASE_DIR wolf3d-portable "${PROJECT_VERSION}" "" "${CMAKE_SOURCE_DIR}" "${W3P_DIST_ROOT}")
set(runtime "$<TARGET_FILE:wolf3d-host>" "$<TARGET_FILE:wolf3d>")
set(licenses "${CMAKE_SOURCE_DIR}/LICENSE|GPL-2.TXT")
if(TARGET nuked-opl3)
    list(APPEND runtime "$<TARGET_FILE:nuked-opl3>")
    list(APPEND licenses "${W3P_WOLF3D_SOURCE_DIR}/third_party/Nuked-OPL3/LICENSE|LGPL-21.TXT")
endif()
if(W3P_BUILD_SDL3)
    list(APPEND runtime "$<TARGET_FILE:SDL3::SDL3-shared>")
    list(APPEND licenses "${W3P_SDL3_LICENSE_FILE}|SDL3.TXT")
endif()
if(W3P_BUILD_SDL1)
    list(APPEND runtime "${SDL1_DLL}")
    list(APPEND licenses "${SDL1_LICENSE}|SDL1.TXT")
endif()
set(staging "${CMAKE_CURRENT_BINARY_DIR}/stage-host-$<CONFIG>.cmake")
file(GENERATE OUTPUT "${staging}" CONTENT
"set(DIST [==[${W3P_RELEASE_DIR}]==])
set(INFO [==[${W3P_RELEASE_DIR_INFO}]==])
set(ROOT [==[${CMAKE_SOURCE_DIR}]==])
set(BUILD [==[${CMAKE_BINARY_DIR}]==])
set(RUNTIME [==[${runtime}]==])
set(LICENSES [==[${licenses}]==])
set(BACKENDS [==[${W3P_BACKENDS}]==])
set(DBOPL ${WG_ENABLE_OPL_DBOPL})
set(INPOUT ${W3P_ENABLE_INPOUT32})
set(ADLIB ${WG_ENABLE_OPL_ADLIB})
set(SDL1 ${W3P_BUILD_SDL1})
include([==[${CMAKE_SOURCE_DIR}/cmake/W3PStageHost.cmake]==])
")
add_custom_target(release COMMAND ${CMAKE_COMMAND} -P "${staging}" DEPENDS wolf3d-host VERBATIM)
# Compatibility aliases all stage the same executable, never competing packages.
foreach(alias win32 sdl3 console)
    add_custom_target(${alias}-release DEPENDS release)
endforeach()
foreach(old W3P_WIN32_RELEASE_DIR W3P_SDL3_RELEASE_DIR W3P_CONSOLE_RELEASE_DIR)
    file(RELATIVE_PATH relative_dist "${CMAKE_SOURCE_DIR}" "${W3P_DIST_ROOT}")
    get_filename_component(package_name "${W3P_RELEASE_DIR}" NAME)
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/${old}-$<CONFIG>.path" CONTENT "${relative_dist}/${package_name}\n")
endforeach()
if(BUILD_TESTING)
    add_executable(wg-video-fallback-test tests/WG_VIDEO_FALLBACK_TEST.c platforms/WG_HELP.c)
    w3p_configure_host(wg-video-fallback-test)
    if(MSVC)
        target_compile_definitions(wg-video-fallback-test PRIVATE _CRT_SECURE_NO_WARNINGS)
    endif()
    add_test(NAME video-fallback-contract COMMAND wg-video-fallback-test)
    add_test(NAME backend-help COMMAND wolf3d-host --help --no-pause)
    add_test(NAME backend-invalid COMMAND wolf3d-host --backend unavailable --no-pause)
    set_tests_properties(backend-invalid PROPERTIES WILL_FAIL TRUE)
    if(W3P_BUILD_SDL3)
        add_executable(wg-sdl-modal-frame-test tests/WG_SDL_MODAL_FRAME_TEST.c)
        target_link_libraries(wg-sdl-modal-frame-test PRIVATE SDL3::SDL3-shared)
        add_test(NAME sdl3-modal-frame COMMAND wg-sdl-modal-frame-test)
    endif()
    if(W3P_BUILD_SDL1 AND MINGW)
        add_executable(wg-sdl1-ddraw-test tests/WG_SDL1_DDRAW_TEST.c platforms/sdl1/WG_SDL1_DYNAMIC.c)
        target_include_directories(wg-sdl1-ddraw-test PRIVATE "${SDL1_INCLUDE}")
        target_link_libraries(wg-sdl1-ddraw-test PRIVATE user32 winmm)
        add_test(NAME sdl1-ddraw COMMAND wg-sdl1-ddraw-test)
        add_library(wg-backend-test-launcher OBJECT platforms/win32/WG_LAUNCHER.c)
        target_compile_definitions(wg-backend-test-launcher PRIVATE
            WG_HAVE_GDI=1 WG_HAVE_SDL1=1 WG_SDL1Run=WG_TestSDL1Run)
        add_executable(wg-backend-test $<TARGET_OBJECTS:wg-backend-test-launcher>
            tests/WG_BACKEND_GDI_STUB.c platforms/sdl1/WG_SDL1.c
            platforms/sdl1/WG_SDL1_DYNAMIC.c platforms/WG_HELP.c platforms/WG_TEXT_OUTPUT.c)
        target_include_directories(wg-backend-test PRIVATE "${SDL1_INCLUDE}")
        target_compile_definitions(wg-backend-test PRIVATE WG_SDL1_DYNAMIC=1)
        target_link_options(wg-backend-test PRIVATE -municode)
        target_link_libraries(wg-backend-test PRIVATE wolf3d user32 winmm)
        add_library(wg-sdl-incomplete SHARED tests/WG_SDL1_INCOMPLETE.c)
        set_target_properties(wg-sdl-incomplete PROPERTIES PREFIX "")
        add_executable(wg-sdl1-dynamic-test tests/WG_SDL1_DYNAMIC_TEST.c)
        target_include_directories(wg-sdl1-dynamic-test PRIVATE "${SDL1_INCLUDE}")
        target_compile_options(wg-sdl1-dynamic-test PRIVATE -Wall -Wextra -Werror)
        add_test(NAME sdl1-dynamic-loader COMMAND wg-sdl1-dynamic-test)
        add_executable(wg-sdl1-dynamic-host-test tests/WG_SDL1_TEST.c
            platforms/sdl1/WG_SDL1_DYNAMIC.c platforms/WG_HELP.c platforms/WG_TEXT_OUTPUT.c)
        target_include_directories(wg-sdl1-dynamic-host-test PRIVATE "${SDL1_INCLUDE}")
        target_compile_definitions(wg-sdl1-dynamic-host-test PRIVATE WG_SDL1_DYNAMIC=1)
        target_link_libraries(wg-sdl1-dynamic-host-test PRIVATE wolf3d user32 winmm)
        add_test(NAME sdl1-dynamic-host COMMAND wg-sdl1-dynamic-host-test)
        set_tests_properties(sdl1-dynamic-host PROPERTIES ENVIRONMENT "SDL_VIDEODRIVER=dummy;SDL_AUDIODRIVER=dummy")
    endif()
endif()
